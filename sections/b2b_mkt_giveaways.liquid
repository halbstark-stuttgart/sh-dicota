{{ section.settings.text_success_heading }}
</h2><div class="text-size-medium max-width-medium"> {{ section.settings.textarea_success_text }} </div><button type="button" class="button w-button" data-mkt-order-restart>
{{ section.settings.text_restart_button }}
</button></div></div></div></div></div><script>(function(){var form=document.getElementById("mkt-order-form-{{ section.id }}");var success=document.getElementById("mkt-order-success-{{ section.id }}");if(!form||!success)return;var btn=form.querySelector(".mkt-order_submit");var lbl=form.querySelector(".mkt-order_submit-label");var ld=form.querySelector(".mkt-order_submit-loading");function busy(on){if(btn)btn.disabled=on;if(lbl)lbl.hidden=on;if(ld)ld.hidden=!on;}function clean(n){var m=String(n).match(/^contact\[(.*)\]$/);return m?m[1]:n;}function txt(el){return (el.innerText||el.textContent||"").replace(/\s+/g," ").trim();}function buildData(){var fd=new FormData();var tbody=form.querySelector(".mkt-order_tbody");var rows=[];if(tbody){var qtys=tbody.querySelectorAll('input[type="number"]');Array.prototype.forEach.call(qtys,function(q){var v=parseInt(q.value,10)||0;if(v<=0)return;var row=q;while(row.parentElement&&row.parentElement!==tbody&&row.parentElement.querySelectorAll('input[type="number"]').length===1){row=row.parentElement;}var extras=[];Array.prototype.forEach.call(row.querySelectorAll("input[name],select[name],textarea[name]"),function(el){if(el===q||!el.value)return;if((el.type==="checkbox"||el.type==="radio")&&!el.checked)return;extras.push({k:clean(el.name),v:el.value});});rows.push({qty:v,extras:extras,label:txt(row)});});}var lines=rows.map(function(r){return r.qty+"x "+(r.extras.length?r.extras.map(function(e){return e.v;}).join(" · "):r.label);});fd.append("Bestellung",lines.length?lines.join("\n"):"Keine Artikel ausgewählt");Array.prototype.forEach.call(form.elements,function(el){if(!el.name||el.disabled)return;if(tbody&&tbody.contains(el))return;if(el.type==="submit"||el.type==="button")return;if((el.type==="checkbox"||el.type==="radio")&&!el.checked)return;fd.append(clean(el.name),el.value);});rows.forEach(function(r,i){var p="Artikel "+(i+1)+" – ";fd.append(p+"Menge",r.qty);if(r.extras.length){r.extras.forEach(function(e){fd.append(p+e.k,e.v);});}else{fd.append(p+"Artikel",r.label);}});return fd;}form.addEventListener("submit",function(e){e.preventDefault();busy(true);fetch(form.action,{method:"POST",body:buildData(),headers:{Accept:"application/json"}}).then(function(r){if(!r.ok)throw new Error("bad response");form.hidden=true;success.hidden=false;success.scrollIntoView({behavior:"smooth",block:"center"});}).catch(function(err){console.error("Giveaway order submit error:",err);HTMLFormElement.prototype.submit.call(form);}).then(function(){busy(false);});});var restart=success.querySelector("[data-mkt-order-restart]");if(restart)restart.addEventListener("click",function(){form.reset();success.hidden=true;form.hidden=false;form.scrollIntoView({behavior:"smooth",block:"start"});});})();</script><style> #shopify-section-{{ section.id }} .mkt-dp{position:relative} #shopify-section-{{ section.id }} .mkt-dp_input{width:100%;padding-right:44px;cursor:pointer} #shopify-section-{{ section.id }} .mkt-dp_toggle{position:absolute;right:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border:0;background:none;color:#0f0f0f;cursor:pointer;border-radius:4px} #shopify-section-{{ section.id }} .mkt-dp_toggle:hover{background:#f3f3f3} #shopify-section-{{ section.id }} .mkt-dp_pop{position:absolute;left:0;top:calc(100% + 8px);z-index:30;width:320px;max-width:100%;padding:16px;background:#fff;border:1px solid #d4d4d4;border-radius:8px;box-shadow:0 12px 32px rgba(15,15,15,.12);color:#0f0f0f;font-family:inherit} #shopify-section-{{ section.id }} .mkt-dp_head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px} #shopify-section-{{ section.id }} .mkt-dp_title{font-size:16px;font-weight:600;text-transform:capitalize} #shopify-section-{{ section.id }} .mkt-dp_nav{display:flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border:0;background:none;color:inherit;border-radius:4px;cursor:pointer} #shopi