meFormat("de",{weekday:"short"});}var today=new Date();today.setHours(0,0,0,0);var minDate=new Date(today);minDate.setDate(minDate.getDate()+1);var selected=null;var skip=false;var view=new Date(minDate.getFullYear(),minDate.getMonth(),1);function pad(n){return(n<10?"0":"")+n;}function fmt(d){return pad(d.getDate())+"."+pad(d.getMonth()+1)+"."+d.getFullYear();}function parse(s){var m=String(s).trim().match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);if(!m)return null;var d=new Date(+m[3],+m[2]-1,+m[1]);return d.getDate()===+m[1]&&d.getMonth()===+m[2]-1?d:null;}function same(a,b){return a&&b&&a.getTime()===b.getTime();}function validate(){var v=input.value.trim();if(!v){selected=null;input.setCustomValidity("");return;}var d=parse(v);if(!d){input.setCustomValidity(T.invalid);return;}if(d<minDate){input.setCustomValidity(T.past);return;}input.setCustomValidity("");selected=d;}function el(tag,cls,text){var e=document.createElement(tag);if(cls)e.className=cls;if(text!=null)e.textContent=text;return e;}var arrowL='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>';var arrowR='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>';function render(){pop.innerHTML="";var head=el("div","mkt-dp_head");var prev=el("button","mkt-dp_nav");prev.type="button";prev.innerHTML=arrowL;prev.setAttribute("aria-label",T.prev);prev.disabled=view.getFullYear()*12+view.getMonth()<=minDate.getFullYear()*12+minDate.getMonth();prev.addEventListener("click",function(){view=new Date(view.getFullYear(),view.getMonth()-1,1);render();});var next=el("button","mkt-dp_nav");next.type="button";next.innerHTML=arrowR;next.setAttribute("aria-label",T.next);next.addEventListener("click",function(){view=new Date(view.getFullYear(),view.getMonth()+1,1);render();});head.appendChild(prev);head.appendChild(el("div","mkt-dp_title",fmtMonth.format(view)));head.appendChild(next);pop.appendChild(head);var grid=el("div","mkt-dp_grid");grid.setAttribute("role","grid");for(var i=0;i<7;i++){grid.appendChild(el("div","mkt-dp_wd",fmtWd.format(new Date(2024,0,1+i)).replace(".","")));}var offset=(view.getDay()+6)%7;for(var j=0;j<offset;j++){grid.appendChild(el("div"));}var days=new Date(view.getFullYear(),view.getMonth()+1,0).getDate();for(var k=1;k<=days;k++){(function(d){var b=el("button","mkt-dp_day",String(d.getDate()));b.type="button";b.setAttribute("aria-label",fmt(d));if(d<minDate)b.disabled=true;if(same(d,today))b.classList.add("is-today");if(same(d,selected)){b.classList.add("is-selected");b.setAttribute("aria-pressed","true");}b.addEventListener("click",function(){input.value=fmt(d);validate();input.dispatchEvent(new Event("input",{bubbles:true}));input.dispatchEvent(new Event("change",{bubbles:true}));close();skip=true;input.focus();skip=false;});grid.appendChild(b);})(new Date(view.getFullYear(),view.getMonth(),k));}pop.appendChild(grid);}function open(){validate();var base=selected||minDate;view=new Date(base.getFullYear(),base.getMonth(),1);render();pop.hidden=false;input.setAttribute("aria-expanded","true");}function close(){pop.hidden=true;input.setAttribute("aria-expanded","false");}input.addEventListener("click",function(){if(pop.hidden)open();});input.addEventListener("focus",function(){if(!skip&&pop.hidden)open();});toggle.addEventListener("click",function(){if(pop.hidden){open();}else{close();}});input.addEventListener("input",validate);input.addEventListener("blur",validate);input.addEventListener("keydown",function(e){if(e.key==="Escape")close();});pop.addEventListener("keydown",function(e){if(e.key==="Escape"){close();input.focus();}});document.addEventListener("click",function(e){if(e.target.isConnected&&!root.contains(e.target))close();});var form=input.form;if(form){form.addEventListener("reset",function(){setTim